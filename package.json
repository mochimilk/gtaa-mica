{
  "name": "gtaa-mica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:voice": "node --watch --env-file-if-exists=.env server/micaLiveServer.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "check:desktop": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run check:desktop && npm run build",
    "start:desktop": "electron .",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "dev:windows": "dotnet run --project desktop -p:Platform=x64 -- --dev-url=http://127.0.0.1:5173/",
    "icons:desktop": "electron scripts/desktop-icons.mjs",
    "check:server": "tsc -p tsconfig.server.json",
    "test": "node --import ./tests/support/register.mjs --test-timeout=20000 --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@coral-ai/bundleicons": "^2.1.0",
    "@coral-ai/charts": "file:vendor/coral/coral-ai-charts-3.10.1.tgz",
    "@coral-ai/chat": "file:vendor/coral/coral-ai-chat-0.6.0.tgz",
    "@coral-ai/markdown": "file:vendor/coral/coral-ai-markdown-0.6.0.tgz",
    "@coral-ai/react": "file:vendor/coral/coral-ai-react-0.6.1.tgz",
    "@fluentui/react-components": "^9.72.11",
    "@fluentui/react-icons": "2.0.322",
    "@fontsource/roboto-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@coral-ai/cli": "file:vendor/coral/coral-ai-cli-0.6.0.tgz",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "main": "electron/main.mjs"
}
