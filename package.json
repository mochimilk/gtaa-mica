{
  "name": "gtaa-mica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate:airport": "node scripts/validate-airport.mjs",
    "test:airport": "node --test scripts/airport-model.test.mjs scripts/gtaa-airport.test.mjs scripts/gtaa-asm.test.mjs scripts/gtaa-asm-aircraft.test.mjs",
    "prepare:gtaa-asm": "node scripts/prepare-gtaa-asm.mjs",
    "validate:catalogs": "node scripts/validate-catalogs.mjs",
    "test:catalogs": "node --test scripts/airport-catalogs.test.mjs",
    "validate:demand": "node scripts/validate-demand.mjs",
    "test:demand": "node --test scripts/demand-model.test.mjs",
    "link:demand": "node scripts/link-demand.mjs",
    "test:linking": "node --test scripts/visit-linker.test.mjs scripts/movement-model.test.mjs",
    "derive:occupancy": "node scripts/derive-occupancy.mjs",
    "test:occupancy": "node --test scripts/occupancy-model.test.mjs",
    "prepare:tows": "node scripts/prepare-tows.mjs",
    "test:tows": "node --test scripts/tow-preparation.test.mjs",
    "build:solver": "dotnet build components/Planning.Solver/src/Planning.Solver.Cli/Planning.Solver.Cli.csproj --nologo",
    "solve:airport": "node scripts/solve-airport.mjs",
    "test:assignments": "npm run build:solver && node --test scripts/local-assignment.test.mjs",
    "generate:scenario": "node scripts/generate-scenario.mjs",
    "run:scenario": "node scripts/generate-scenario.mjs --solve",
    "test:scenarios": "npm run build:solver && node --test scripts/scenario-generator.test.mjs scripts/gtaa-scenario.test.mjs",
    "prepare:demo": "npm run build:solver && node scripts/prepare-demo.mjs && npm run prepare:atlas && npm run prepare:accommodation && npm run prepare:tow-windows",
    "prepare:demo:gtaa": "npm run build:solver && node scripts/prepare-demo.mjs --airport data/airports/gtaa/airport.json --profile data/airports/gtaa/demand/scenario-profile.json --case full-day --tow-profile data/airports/gtaa/demand/tow-profile.json --output src/demo/prepared/gtaa/full-day.json",
    "prepare:capacity": "node scripts/prepare-capacity.mjs && npm run prepare:atlas && npm run prepare:accommodation && npm run prepare:tow-windows",
    "prepare:tow-windows": "node scripts/prepare-tow-windows.mjs",
    "prepare:accommodation": "node scripts/prepare-accommodation.mjs",
    "test:accommodation": "node --test scripts/accommodation.test.mjs",
    "prepare:atlas": "node scripts/prepare-atlas.mjs",
    "test:atlas": "node --test scripts/capacity-atlas.test.mjs",
    "test:capacity": "node --test scripts/capacity-probe.test.mjs",
    "test:demo": "node --disallow-code-generation-from-strings --test scripts/demo-dataset.test.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "check:desktop": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run check:desktop && npm run build",
    "start:desktop": "electron .",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@coral-ai/bundleicons": "^2.1.0",
    "@coral-ai/charts": "file:vendor/coral/coral-ai-charts-3.10.1.tgz",
    "@coral-ai/chat": "file:vendor/coral/coral-ai-chat-0.6.0.tgz",
    "@coral-ai/docs": "file:vendor/coral/coral-ai-docs-0.6.0.tgz",
    "@coral-ai/markdown": "file:vendor/coral/coral-ai-markdown-0.6.0.tgz",
    "@coral-ai/react": "file:vendor/coral/coral-ai-react-0.6.1.tgz",
    "@fluentui/react-components": "^9.72.11",
    "@fluentui/react-icons": "2.0.322",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "@coral-ai/cli": "file:vendor/coral/coral-ai-cli-0.6.0.tgz",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "main": "electron/main.mjs"
}
