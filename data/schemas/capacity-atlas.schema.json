{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:capacity-atlas:2.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "metric_id", "metric_version", "source", "time_basis", "airport_id", "case_id", "demand_id", "snapshot_fingerprint", "airport_fingerprint", "demand_fingerprint", "plan_window", "variants", "horizon_duration_ms", "capacity_fingerprint", "profile", "days"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "metric_id": { "const": "airport-opportunity-recurrence" }, "metric_version": { "const": "1.0.0" },
    "source": { "const": "synthetic-timing-replays" }, "time_basis": { "const": "utc-horizon-relative" },
    "case_id": { "$ref": "#/definitions/id" },
    "airport_id": { "$ref": "#/definitions/id" },
    "demand_id": { "$ref": "#/definitions/id" },
    "snapshot_fingerprint": { "$ref": "#/definitions/fingerprint" },
    "airport_fingerprint": { "$ref": "#/definitions/fingerprint" },
    "demand_fingerprint": { "$ref": "#/definitions/fingerprint" },
    "plan_window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "variants": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "tow-options"],
      "properties": {
        "baseline": { "$ref": "#/definitions/request" },
        "tow-options": { "$ref": "#/definitions/request" }
      }
    },
    "horizon_duration_ms": { "type": "integer", "minimum": 1 },
    "capacity_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile": { "$ref": "urn:gtaa-mica:capacity-atlas-profile:1.0.0" },
    "days": { "type": "array", "minItems": 1, "maxItems": 31, "items": { "$ref": "#/definitions/day" } }
  },
  "definitions": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["request_fingerprint"],
      "properties": { "request_fingerprint": { "$ref": "#/definitions/fingerprint" } }
    },
    "id": { "type": "string", "pattern": "^\\S+$" },
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["planned_shift_minutes", "planned_scale_basis_points", "outcome_shift_minutes", "outcome_scale_basis_points"],
      "properties": {
        "planned_shift_minutes": { "type": "integer", "minimum": -120, "maximum": 120 },
        "planned_scale_basis_points": { "type": "integer", "minimum": 9500, "maximum": 10500 },
        "outcome_shift_minutes": { "type": "integer", "minimum": -120, "maximum": 120 },
        "outcome_scale_basis_points": { "type": "integer", "minimum": 9500, "maximum": 10500 }
      }
    },
    "window": {
      "type": "array", "minItems": 2, "maxItems": 2, "additionalItems": false,
      "items": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }]
    },
    "probe": {
      "type": "object", "additionalProperties": false, "required": ["id", "rows"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "rows": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["stand_id", "windows"],
          "properties": {
            "stand_id": { "$ref": "#/definitions/id" },
            "windows": { "type": "array", "items": { "$ref": "#/definitions/window" } }
          }
        } }
      }
    },
    "phases": {
      "type": "object", "additionalProperties": false, "required": ["planned", "end_of_day"],
      "properties": {
        "planned": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/probe" } },
        "end_of_day": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/probe" } }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false, "required": ["date", "parameters", "variants"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "parameters": { "$ref": "#/definitions/parameters" },
        "variants": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "tow-options"],
          "properties": { "baseline": { "$ref": "#/definitions/phases" }, "tow-options": { "$ref": "#/definitions/phases" } }
        }
      }
    }
  }
}
