{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:operating-policy:1.0.0",
  "title": "Airport minimum leg handling windows",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "airport_id", "description", "minimum-leg-windows"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "airport_id": { "type": "string", "pattern": "^\\S+$" },
    "description": { "type": "string", "pattern": "\\S" },
    "default-tow-minutes": { "type": "integer", "minimum": 1 },
    "minimum-leg-windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aircraft-size-codes", "arrival-minutes", "departure-minutes"],
        "properties": {
          "aircraft-size-codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["A", "B", "C", "D", "E", "F"] }
          },
          "arrival-minutes": { "type": "integer", "minimum": 1 },
          "departure-minutes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
