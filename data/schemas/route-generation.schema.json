{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:route-generation:1.0.0",
  "title": "Illustrative international and transborder market preferences",
  "type": "object",
  "additionalProperties": false,
  "required": ["markets"],
  "properties": {
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight", "airports"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\S+$" },
          "weight": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "airports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["airport_code", "weight"],
              "properties": {
                "airport_code": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "weight": { "type": "integer", "minimum": 1, "maximum": 1000000 }
              }
            }
          }
        }
      }
    }
  }
}
