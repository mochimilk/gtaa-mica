{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:airline-groups:1.0.0",
  "title": "Disjoint airline planning groups",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "airlines"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\S+$" },
          "name": { "type": "string", "pattern": "\\S" },
          "description": { "type": "string" },
          "airlines": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\S+$" }
          }
        }
      }
    }
  }
}
