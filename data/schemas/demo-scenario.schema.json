{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:demo-scenario:1.0.0",
  "title": "Compact prepared scenario for the local demo UI",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "demand_id", "plan_window", "rows", "visits", "flights", "variants"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "case_id": { "enum": ["comfortable", "constrained"] },
    "demand_id": { "$ref": "#/definitions/id" },
    "plan_window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/definitions/instant" }, "end": { "$ref": "#/definitions/instant" } }
    },
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label"],
        "properties": { "id": { "$ref": "#/definitions/id" }, "label": { "type": "string" }, "group": { "type": "string" } }
      }
    },
    "visits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["turnId", "carrier", "arrFlight", "depFlight", "origin", "destination", "registration", "aircraftType"],
        "properties": {
          "turnId": { "$ref": "#/definitions/id" },
          "carrier": { "$ref": "#/definitions/id" },
          "arrFlight": { "$ref": "#/definitions/id" },
          "depFlight": { "$ref": "#/definitions/id" },
          "origin": { "$ref": "#/definitions/id" },
          "destination": { "$ref": "#/definitions/id" },
          "registration": { "$ref": "#/definitions/id" },
          "aircraftType": { "$ref": "#/definitions/id" }
        }
      }
    },
    "flights": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "visitId", "direction", "flight", "routeEnd", "scheduled"],
        "properties": {
          "id": { "$ref": "#/definitions/id" }, "visitId": { "$ref": "#/definitions/id" },
          "direction": { "enum": ["arrival", "departure"] }, "flight": { "$ref": "#/definitions/id" },
          "routeEnd": { "$ref": "#/definitions/id" }, "scheduled": { "$ref": "#/definitions/instant" }
        }
      }
    },
    "variants": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "tow-options"],
      "properties": { "baseline": { "$ref": "#/definitions/plan" }, "tow-options": { "$ref": "#/definitions/plan" } }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^\\S+$" },
    "instant": { "type": "string", "format": "date-time" },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["solver_status", "request_fingerprint", "covered_flight_count", "generated_movement_count", "stand_validation_passed", "stays"],
      "properties": {
        "solver_status": { "enum": ["optimal", "feasible"] },
        "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "covered_flight_count": { "type": "integer", "minimum": 0 },
        "generated_movement_count": { "type": "integer", "minimum": 0, "multipleOf": 2 },
        "stand_validation_passed": { "const": true },
        "stays": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "visitId", "rowId", "start", "end", "towIn", "towOut"],
            "properties": {
              "id": { "$ref": "#/definitions/id" }, "visitId": { "$ref": "#/definitions/id" },
              "rowId": { "$ref": "#/definitions/id" },
              "start": { "$ref": "#/definitions/instant" }, "end": { "$ref": "#/definitions/instant" },
              "arrivalFlightId": { "$ref": "#/definitions/id" }, "departureFlightId": { "$ref": "#/definitions/id" },
              "towIn": { "type": "boolean" }, "towOut": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
