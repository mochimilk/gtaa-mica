{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:capacity-profile:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "metric_id", "metric_version", "default_probe_id", "probes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/definitions/id" },
    "metric_id": { "const": "airport-single-turn-capacity" },
    "metric_version": { "const": "1.0.0" },
    "default_probe_id": { "$ref": "#/definitions/id" },
    "probes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/probe" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^\\S+$" },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "aircraft_id", "operating_airline_id", "arrival_sector_id", "departure_sector_id", "default_duration_minutes", "separation_minutes"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "label": { "type": "string", "pattern": "\\S" },
        "aircraft_id": { "$ref": "#/definitions/id" }, "operating_airline_id": { "$ref": "#/definitions/id" },
        "arrival_sector_id": { "$ref": "#/definitions/id" }, "departure_sector_id": { "$ref": "#/definitions/id" },
        "default_duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "separation_minutes": { "type": "integer", "minimum": 0, "maximum": 120 }
      }
    }
  }
}
