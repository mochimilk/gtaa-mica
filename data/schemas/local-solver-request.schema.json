{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gtaa-mica:local-solver-request:1.0.0",
  "title": "Atomic occupancy assignment request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "time_limit_seconds", "groups", "candidates", "conflicts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/definitions/id" },
    "time_limit_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "flight_count", "mandatory", "options"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "flight_count": { "type": "integer", "minimum": 0, "maximum": 2 },
          "mandatory": { "type": "boolean" },
          "options": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "demand_ids", "generated_movements"],
              "properties": {
                "id": { "$ref": "#/definitions/id" },
                "demand_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
                "generated_movements": { "enum": [0, 2] }
              }
            }
          }
        }
      }
    },
    "candidates": { "type": "array", "items": { "$ref": "#/definitions/candidate" } },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["first_candidate_id", "second_candidate_id"],
        "properties": { "first_candidate_id": { "$ref": "#/definitions/id" }, "second_candidate_id": { "$ref": "#/definitions/id" } }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^\\S+$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["id", "demand_id", "stand_id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "demand_id": { "$ref": "#/definitions/id" },
        "stand_id": { "$ref": "#/definitions/id" }
      }
    }
  }
}
