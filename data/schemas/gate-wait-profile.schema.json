{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-wait-profile.schema.json",
  "title": "Synthetic stand-release delay evaluation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "metric_id", "metric_version", "model_id", "model_version", "source", "default_assumption_id", "assumptions"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "\\S" },
    "metric_id": { "const": "airport-predicted-stand-wait" },
    "metric_version": { "const": "1.0.0" },
    "model_id": { "type": "string", "pattern": "\\S" },
    "model_version": { "const": "1.0.0" },
    "source": { "const": "synthetic" },
    "default_assumption_id": { "type": "string", "pattern": "\\S" },
    "assumptions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "release_delay_probability", "expected_release_delay_minutes_given_delay"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "label": { "type": "string", "pattern": "\\S" },
          "release_delay_probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "expected_release_delay_minutes_given_delay": { "type": "number", "minimum": 0, "maximum": 240 }
        }
      }
    }
  }
}
