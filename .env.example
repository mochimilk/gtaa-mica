# GPT-Live voice for Mica. Full setup: docs/gpt-live-voice.md.
#
# These settings are read by the voice broker (server/micaLiveServer.mjs),
# started with `npm run dev:voice`. Copy this file to a private .env and fill
# it in locally; .env is gitignored and this template stays credential-free.

# SERVER ONLY. Never prefix with VITE_, never ship in Electron.
# Used for both the GPT-Live session and the interpreter model below.
OPENAI_API_KEY=

# GPT-Live session. Mica is written against these values; the broker validates
# them and refuses any delegation mode other than "client".
MICA_LIVE_MODEL=gpt-live-1
MICA_LIVE_VOICE=
MICA_LIVE_DELEGATION=client

# Optional. Travis's voice, when he answers Skye aloud on an approval call
# (a second session, which hears silence). Default ripple.
# MICA_TRAVIS_VOICE=ripple

# REQUIRED FOR VOICE ACTIONS.
# GPT-Live's client delegation sends no task text, so Mica asks an OpenAI
# Responses model to turn the transcript into one structured action.
# gpt-6-luna is the chosen model for this project. There is no runtime
# fallback: if this is blank, calls still connect and talk normally but Mica
# says it cannot act on requests, and /api/live/interpret answers 503
# interpreter_not_configured.
MICA_INTERPRETER_MODEL=gpt-6-luna

# Optional. Output budget per interpretation, which also covers reasoning
# tokens. Default 2000, clamped to 256-16000. Raise it if the interpreter
# reports interpreter_budget_exhausted with your chosen model.
# MICA_INTERPRETER_MAX_OUTPUT_TOKENS=2000

# Optional broker settings.
# MICA_LIVE_PORT=8787
# MICA_LIVE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,mica://app

# Optional, Electron main process only: the broker origin added to the
# packaged app's connect-src. Loopback http origins only. Default below.
# MICA_LIVE_BACKEND_ORIGIN=http://127.0.0.1:8787

# Public Vite settings. Never put a credential or session token in a VITE_*
# variable; everything here is inlined into the client bundle.
#
# Only needed for a PACKAGED Electron build, which has no dev-server proxy.
# Leave unset for browser and Electron development.
# VITE_MICA_API_BASE_URL=http://127.0.0.1:8787
#
# Set to "phrase" to use the offline phrase matcher instead of the interpreter
# model, for demos and tests. Unset means the real interpreter.
# VITE_MICA_INTERPRETER=phrase
